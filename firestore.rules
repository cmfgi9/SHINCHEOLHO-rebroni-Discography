rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 앨범: 누구나 읽기, 관리자만 쓰기
    // (트랙의 audioUrl 필드는 albums 문서 안에 포함되어 있으므로 자동으로 공개 읽기 가능)
    match /albums/{albumId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 관리자 명단: 본인 문서만 읽기 가능(권한 확인용), 쓰기는 콘솔에서만
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 방명록 (Fan Wall): 누구나 읽기/작성. 삭제는 비밀번호 해시 일치(soft delete) 또는 관리자
    match /guestbook/{entryId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'pwHash', 'createdAt', 'deleted'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 500
        && request.resource.data.pwHash is string
        && request.resource.data.pwHash.size() == 64
        && request.resource.data.createdAt is string
        && request.resource.data.deleted == false;

      // 방문자 셀프 삭제: 제출한 pwHash가 저장된 값과 일치할 때만 deleted 플래그 변경 허용
      allow update: if (
          request.resource.data.pwHash == resource.data.pwHash
          && request.resource.data.deleted == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
        ) || isAdmin();

      allow delete: if isAdmin();
    }

    // 뉴스레터 구독자: 누구나 신규 등록만 가능(문서 ID = 이메일 → 중복 등록 차단), 열람은 관리자만
    // 구독 해지: 이메일 주소를 아는 사람은 누구나 해당 문서를 삭제 가능 (사이트의 '구독 해지' 버튼).
    //   목록 열람은 관리자만 가능하므로 다른 구독자의 이메일을 알아낼 수는 없고,
    //   없는 문서를 삭제해도 같은 결과가 나와 구독 여부도 드러나지 않음
    match /subscribers/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email == email
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 150
        && request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$')
        && request.resource.data.createdAt is string;
      allow read: if isAdmin();
      allow delete: if true;
      allow update: if false;
    }

    // 창작 노트 (Creator's Journal): 관리자만 작성/수정/삭제.
    //   html = 서식 본문(사이트에서 허용 태그만 남겨 표시), body = 일반 텍스트 사본, media = 첨부 파일 Storage 경로
    //   공개(published == true) 노트는 누구나 읽기, 비공개 노트는 관리자만 읽기.
    //   공개 페이지는 반드시 where('published', '==', true) 조건으로 조회해야 규칙을 통과함
    match /notes/{noteId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'body', 'html', 'media', 'date', 'tags', 'albumId', 'published', 'createdAt', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 50000
        && (!('html' in request.resource.data) || (request.resource.data.html is string && request.resource.data.html.size() <= 300000))
        && (!('media' in request.resource.data) || (request.resource.data.media is list && request.resource.data.media.size() <= 100))
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.tags is list
        && request.resource.data.published is bool;
      allow delete: if isAdmin();
    }

    // 영상 (YouTube Videos): 문서 ID = 유튜브 영상 ID(11자). 관리자만 작성/수정/삭제.
    //   공개(published == true) 영상은 누구나 읽기, 비공개 영상은 관리자만 읽기.
    //   공개 페이지는 반드시 where('published', '==', true) 조건으로 조회해야 규칙을 통과함
    match /videos/{videoId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin()
        && videoId.matches('^[A-Za-z0-9_-]{11}$')
        && request.resource.data.keys().hasOnly(['youtubeId', 'title', 'kind', 'albumId', 'track', 'date', 'description', 'isShort', 'published', 'createdAt', 'updatedAt'])
        && request.resource.data.youtubeId == videoId
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 200
        && request.resource.data.kind in ['album', 'unreleased', 'etc']
        && request.resource.data.albumId is string
        && request.resource.data.track is string
        && request.resource.data.track.size() <= 200
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 5000
        && request.resource.data.isShort is bool
        && request.resource.data.published is bool;
      allow delete: if isAdmin();
    }

    // 향후 확장 예약 (커머스):
    // match /products/{productId} { allow read: if true; allow write: if isAdmin(); }
    // match /orders/{orderId} { ... 구매자 본인 + 관리자만 ... }

    // 그 외 모든 문서 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
