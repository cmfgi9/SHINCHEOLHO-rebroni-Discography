rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // 커버 이미지: 누구나 읽기, 관리자만 업로드/삭제 (10MB 이하 이미지)
    match /covers/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // 음원 파일: 누구나 읽기(공개 URL 제공용), 관리자만 업로드/삭제 (20MB 이하 오디오)
    match /tracks/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if isAdmin();
    }

    // 창작 노트 첨부(사진·음원 스케치): 누구나 읽기, 관리자만 업로드/삭제 (20MB 이하 이미지/오디오)
    match /journal/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('audio/.*'));
      allow delete: if isAdmin();
    }

    // 그 외 경로 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
